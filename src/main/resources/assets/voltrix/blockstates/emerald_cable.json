{
  "multipart": [
    {
      "apply": {
        "model": "voltrix:block/emerald_cable_dot"
      }
    },
    {
      "when": {
        "east": "cable"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable",
        "y": 90
      }
    },
    {
      "when": {
        "east": "machine"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable_connect",
        "y": 90
      }
    },
    {
      "when": {
        "west": "cable"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable",
        "y": 270
      }
    },
    {
      "when": {
        "west": "machine"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable_connect",
        "y": 270
      }
    },
    {
      "when": {
        "north": "cable"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable"
      }
    },
    {
      "when": {
        "north": "machine"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable_connect"
      }
    },
    {
      "when": {
        "south": "cable"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable",
        "y": 180
      }
    },
    {
      "when": {
        "south": "machine"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable_connect",
        "y": 180
      }
    },
    {
      "when": {
        "up": "cable"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable",
        "x": 270
      }
    },
    {
      "when": {
        "up": "machine"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable_connect",
        "x": 270
      }
    },
    {
      "when": {
        "down": "cable"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable",
        "x": 90
      }
    },
    {
      "when": {
        "down": "machine"
      },
      "apply": {
        "model": "voltrix:block/emerald_cable_connect",
        "x": 90
      }
    },
    {
      "when": {
        "covered": true
      },
      "apply": {
        "model": "voltrix:block/cable_covered"
      }
    }
  ]
}